table inet clash {
	comment "managed-by=boxctl/v1 plan-sha256=2e06f867639ed83e85d3c1aeae7a5c0fcb9d00f4a3889ffbd64b8f2c861b8e11"
	set capture4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 198.18.0.0/16, 198.18.1.9/32 }
	}

	set bypass4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 192.88.99.0/24, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 255.255.255.255/32 }
	}

	set source_bypass4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 192.0.2.32/28 }
	}

	set proxy_servers4 {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 1.1.1.1/32, 9.9.9.9/32 }
	}

	set bypass_uids {
		type uid
		elements = { 99, 65534 }
	}

	chain mark_traffic {
		meta mark 0x00000002 return
		meta mark & 0x0000ff00 != 0x00000000 return
		fib daddr type local return
		udp sport 67 udp dport 68 return
		udp sport 68 udp dport 67 return
		tcp dport { 7890, 7891, 7892, 7893, 7894 } return
		udp dport { 7890, 7891, 7892, 7893, 7894 } return
		iifname != { "br-lan", "lan2" } return
		iifname { "wan" } return
		ip saddr @source_bypass4 return
		udp dport 443 reject
		ip daddr @proxy_servers4 return
		tcp dport != { 443, 8443 } return
		udp dport != { 443 } return
		ip daddr @capture4 meta l4proto udp meta mark set 0x00000003
	}

	chain prerouting_mangle {
		type filter hook prerouting priority mangle; policy accept;
		ct status dnat return
		jump mark_traffic
	}

	chain prerouting_redirect {
		type nat hook prerouting priority dstnat; policy accept;
		ct status dnat return
		meta mark 0x00000002 return
		meta mark & 0x0000ff00 != 0x00000000 return
		fib daddr type local return
		udp sport 67 udp dport 68 return
		udp sport 68 udp dport 67 return
		tcp dport { 7890, 7891, 7892, 7893, 7894 } return
		udp dport { 7890, 7891, 7892, 7893, 7894 } return
		iifname != { "br-lan", "lan2" } return
		iifname { "wan" } return
		ip saddr @source_bypass4 return
		ip daddr @proxy_servers4 return
		tcp dport != { 443, 8443 } return
		udp dport != { 443 } return
		ip daddr @capture4 meta l4proto tcp redirect to :7893
	}

	chain output_mark {
		type route hook output priority mangle; policy accept;
		ct status dnat return
		meta mark 0x00000002 return
		meta mark & 0x0000ff00 != 0x00000000 return
		udp sport 67 udp dport 68 return
		udp sport 68 udp dport 67 return
		tcp sport { 7890, 7891, 7892, 7893, 7894 } return
		udp sport { 7890, 7891, 7892, 7893, 7894 } return
		meta skuid @bypass_uids return
		ip daddr @proxy_servers4 return
		tcp dport != { 443, 8443 } return
		udp dport != { 443 } return
		ip daddr @capture4 meta l4proto udp meta mark set 0x00000003
	}

	chain output_redirect {
		type nat hook output priority dstnat; policy accept;
		ct status dnat return
		meta mark 0x00000002 return
		meta mark & 0x0000ff00 != 0x00000000 return
		udp sport 67 udp dport 68 return
		udp sport 68 udp dport 67 return
		tcp sport { 7890, 7891, 7892, 7893, 7894 } return
		udp sport { 7890, 7891, 7892, 7893, 7894 } return
		meta skuid @bypass_uids return
		ip daddr @proxy_servers4 return
		tcp dport != { 443, 8443 } return
		udp dport != { 443 } return
		ip daddr @capture4 meta l4proto tcp redirect to :7893
	}

	chain tun_input {
		type filter hook input priority -10; policy accept;
		iifname "clash-tun" accept
	}

	chain tun_forward {
		type filter hook forward priority -10; policy accept;
		iifname "clash-tun" accept
		oifname "clash-tun" accept
	}

	chain dns_redirect {
		type nat hook prerouting priority -155; policy accept;
		meta mark 0x00000002 return
		meta mark & 0x0000ff00 != 0x00000000 return
		fib daddr type local return
		udp sport 67 udp dport 68 return
		udp sport 68 udp dport 67 return
		tcp dport { 7890, 7891, 7892, 7893, 7894 } return
		udp dport { 7890, 7891, 7892, 7893, 7894 } return
		iifname != { "br-lan", "lan2" } return
		iifname { "wan" } return
		ip saddr @source_bypass4 return
		ip daddr @proxy_servers4 return
		ip daddr @bypass4 return
		tcp dport != { 443, 8443 } return
		udp dport != { 443 } return
		tcp dport 53 redirect to :7874
		udp dport 53 redirect to :7874
	}

}
